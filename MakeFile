# Define the C++ compiler
CXX = g++

# Define CXXFLAGS (compiler flags)
CXXFLAGS = -std=c++17 -Wall -Wextra -pedantic -g -I.

# Define the name of the final executable
TARGET = simulator

# Use wildcard to automatically find all .cpp files in the current directory
SRCS = $(wildcard *.cpp)

# Automatically generate a list of object (.o) files from the source files
OBJS = $(SRCS:.cpp=.o)

# The default 'all' target: builds the final executable
all: $(TARGET)

# Rule to link object files into the executable
$(TARGET): $(OBJS)
	$(CXX) $(OBJS) -o $(TARGET) $(LDFLAGS)

# Pattern rule: how to compile any .cpp file into a .o file
%.o: %.cpp
	$(CXX) $(CXXFLAGS) -c $< -o $@

# Phony targets: these are not actual files, just names for commands
.PHONY: all clean

# Rule to clean up compiled files
clean:
	rm -f $(OBJS) $(TARGET)